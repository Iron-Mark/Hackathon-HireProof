#!/usr/bin/env bash
# Local convenience guard: fail at commit time rather than at PR time.
#
# Install (per clone):
#   cp hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
#
# This cannot catch commits made through the GitHub web UI or API - no local
# hook runs for those. Identity Guard in CI is the real gate.

set -uo pipefail

FORBIDDEN="${IDENTITY_GUARD_PATTERN:-trampettimg}"
msg_file="$1"

# The identity git is about to stamp on this commit.
ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"

trailers="$(grep -iE '^[[:space:]]*(co-authored-by|signed-off-by):' "$msg_file" || true)"

hits="$(printf '%s\n%s\n' "$ident" "$trailers" | grep -inE "$FORBIDDEN" || true)"

if [ -n "$hits" ]; then
  echo "error: this commit carries the work-account identity '${FORBIDDEN}':" >&2
  printf '%s\n' "$hits" | sed 's/^/    /' >&2
  echo >&2
  echo "Fix the trailer in your message, or correct the identity:" >&2
  echo "    git config user.email 67873853+Iron-Mark@users.noreply.github.com" >&2
  exit 1
fi
