{
  "name": "hireproof-api",
  "label": "HireProof API",
  "type": "apiKey",
  "baseUrl": "https://hireproof.tech",
  "parameters": [
    {
      "name": "apiKey",
      "label": "API Key",
      "type": "password",
      "required": true,
      "help": "Use an account-issued or private self-hosted HireProof API key. Demo fixtures still require an API key."
    },
    {
      "name": "baseUrl",
      "label": "Base URL",
      "type": "url",
      "required": true,
      "default": "https://hireproof.tech"
    }
  ],
  "headers": {
    "x-api-key": "{{connection.apiKey}}",
    "Content-Type": "application/json"
  },
  "test": {
    "method": "GET",
    "url": "{{connection.baseUrl}}/api/health"
  }
}
